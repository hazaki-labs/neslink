{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neslink",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // RELAY_NODES and RELAY_ALLOW_INSECURE are set as Worker variables in the Cloudflare
  // dashboard so node addresses stay out of Git; keep_vars stops deploys from wiping them.
  // Signing keys live in the RELAY_SIGNING_KEYS secret. See docs/relay-nodes.md.
  "keep_vars": true,
  // One Worker serves the built SPA and the API; only /api/* reaches the Worker code.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // One Durable Object per room: it relays inputs between the players in it.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
